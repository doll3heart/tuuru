{
  "name": "reverie-works",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "build:verify": "tsc -b --pretty false && node scripts/verify-builds.mjs",
    "verify": "npm test && npm run build:verify",
    "test": "node --test",
    "test:locks:browser": "node scripts/serve-lock-harness.mjs --port 4177 --timeout 180000",
    "test:phone-export:browser": "node scripts/run-phone-export-browser.mjs",
    "test:phone-export:text": "node scripts/run-phone-export-text-browser.mjs",
    "verify:phone-export": "npm run verify && npm run test:phone-export:browser && npm run test:phone-export:text",
    "preview": "vite preview --config vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "jsdom": "^27.0.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13"
  }
}
